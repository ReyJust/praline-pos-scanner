# Copy to .env for local runs. On Hostinger, set these as environment variables instead.
AZURE_CU_ENDPOINT=https://<your-resource>.services.ai.azure.com
AZURE_CU_KEY=<key 1 from Keys and Endpoint>
# Password staff enter once per phone. Required when the site is public.
APP_PASSWORD=<choose a password>
# Analyzer on that resource (created by azure/run.py)
AZURE_CU_ANALYZER_ID=pralineBox
